{
  "name": "tsr-shared-routes",
  "version": "0.0.0",
  "description": "Mount a shared directory of TanStack Router file-based routes at multiple paths.",
  "keywords": [
    "file-based-routing",
    "shared-routes",
    "tanstack",
    "tanstack-router",
    "tanstack-start",
    "vite-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallpants/tsr-shared-routes.git",
    "directory": "workspaces/plugin"
  },
  "bin": {
    "tsr-shared-routes": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run test && cp ../../README.md ./README.md",
    "postpublish": "git checkout -- README.md"
  },
  "dependencies": {
    "@tanstack/router-generator": "^1.167.28",
    "@tanstack/router-utils": "^1.162.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/router-core": "^1.171.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.170.0",
    "@tanstack/router-core": ">=1.171.0",
    "react": ">=18.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
