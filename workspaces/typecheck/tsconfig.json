{
  "include": ["src", "scripts"],
  "compilerOptions": {
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "noEmit": true
  }
}
